  #legend { position: fixed; bottom: 100px; right: 14px; background: rgba(0,0,0,.7); padding: 12px 14px; border-radius: 8px; font-size: 11px; line-height: 1.7; backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,.08); transition: all .3s ease; }
  #legend.collapsed { padding: 6px 10px; }
  #legend.collapsed > div:not(.toggle) { display: none; }
