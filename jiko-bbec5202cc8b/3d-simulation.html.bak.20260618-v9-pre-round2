function makeStarMarker(x, z, label) {
  const shape = new THREE.Shape();
  const outer = 1.3, inner = 0.55;
  for (let i = 0; i < 10; i++) {
    const r = i % 2 === 0 ? outer : inner;
    const angle = (i / 10) * Math.PI * 2 - Math.PI / 2;
    const px = Math.cos(angle) * r, py = Math.sin(angle) * r;
    if (i === 0) shape.moveTo(px, py); else shape.lineTo(px, py);
  }
  shape.closePath();
  const star = new THREE.Mesh(
    new THREE.ExtrudeGeometry(shape, { depth: 0.18, bevelEnabled: false }),
    new THREE.MeshStandardMaterial({ color: 0xff3030, emissive: 0xff2020, emissiveIntensity: 0.8 })
  );
  star.rotation.x = -Math.PI / 2;
  star.position.set(x, 0.06, z);
  scene.add(star);

  const c = document.createElement('canvas');
  c.width = 768; c.height = 140;
  const ctx = c.getContext('2d');
  ctx.fillStyle = 'rgba(217, 48, 37, 0.92)';
  ctx.fillRect(0, 0, 768, 140);
  ctx.strokeStyle = 'rgba(255,255,255,0.3)';
  ctx.lineWidth = 3;
  ctx.strokeRect(2, 2, 764, 136);
  ctx.fillStyle = '#fff';
  ctx.font = 'bold 52px sans-serif';
