  #loading .spinner { width: 56px; height: 56px; border: 3px solid rgba(255,213,79,.15); border-top: 3px solid #ffd54f; border-radius: 50%; animation: spin 1s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
