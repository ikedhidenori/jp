  // ヘッドライト (前方、白く光る)
  const headlightMat = new THREE.MeshStandardMaterial({
    color: 0xfff8e0, emissive: 0xfff8e0, emissiveIntensity: 0.8, roughness: 0.2
  });
  [[-width * 0.32, length / 2], [width * 0.32, length / 2]].forEach(([hx, hz]) => {
    const hl = new THREE.Mesh(new THREE.BoxGeometry(0.32, 0.18, 0.06), headlightMat);
    hl.position.set(hx, bodyHeight * 0.55 + 0.42, hz);
