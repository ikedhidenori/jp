<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
import { OutputPass } from 'three/addons/postprocessing/OutputPass.js';

// =========================================================================
// 座標系: X=東(+)/西(-), Z=南(+)/北(-), Y=上(+) / 左側通行
// =========================================================================

const scene = new THREE.Scene();

// === 空 (グラデーション スカイドーム) ===
const skyGeo = new THREE.SphereGeometry(300, 32, 32);
const skyCanvas = document.createElement('canvas');
skyCanvas.width = 256; skyCanvas.height = 512;
const skyCtx = skyCanvas.getContext('2d');
const skyGrad = skyCtx.createLinearGradient(0, 0, 0, 512);
skyGrad.addColorStop(0, '#74a4d4');   // 上空
skyGrad.addColorStop(0.55, '#bcd5ea'); // 中
skyGrad.addColorStop(1, '#e8eef4');   // 地平線
skyCtx.fillStyle = skyGrad;
skyCtx.fillRect(0, 0, 256, 512);
// 薄い雲
skyCtx.fillStyle = 'rgba(255,255,255,0.35)';
for (let i = 0; i < 12; i++) {
  const cx = Math.random() * 256, cy = 30 + Math.random() * 120;
  skyCtx.beginPath();
  skyCtx.ellipse(cx, cy, 30 + Math.random() * 40, 8 + Math.random() * 12, 0, 0, Math.PI * 2);
  skyCtx.fill();
}
const skyTex = new THREE.CanvasTexture(skyCanvas);
const skyMat = new THREE.MeshBasicMaterial({ map: skyTex, side: THREE.BackSide });
const sky = new THREE.Mesh(skyGeo, skyMat);
scene.add(sky);

scene.fog = new THREE.Fog(0xbcd5ea, 100, 250);

const camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 500);
camera.position.set(0, 38, 30);
camera.lookAt(0, 0, 0);

const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.05;
document.getElementById('scene').appendChild(renderer.domElement);

// === ポストプロセシング (Bloom) ===
const composer = new EffectComposer(renderer);
composer.addPass(new RenderPass(scene, camera));
const bloomPass = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 0.35, 0.6, 0.85);
composer.addPass(bloomPass);
composer.addPass(new OutputPass());

const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.dampingFactor = 0.08;
controls.target.set(0, 0, 0);
controls.maxPolarAngle = Math.PI * 0.495;
controls.minDistance = 3;
controls.maxDistance = 120;

// === 照明 ===
const hemi = new THREE.HemisphereLight(0xc8dcf0, 0x6b7c8a, 0.55);
scene.add(hemi);

const sun = new THREE.DirectionalLight(0xfff2dc, 1.4);
sun.position.set(38, 65, 22);
sun.castShadow = true;
sun.shadow.mapSize.set(4096, 4096);
sun.shadow.camera.left = -60; sun.shadow.camera.right = 60;
sun.shadow.camera.top = 60; sun.shadow.camera.bottom = -60;
sun.shadow.camera.near = 0.1; sun.shadow.camera.far = 220;
sun.shadow.bias = -0.0008;
sun.shadow.radius = 4;
scene.add(sun);

// 補助光
const fill = new THREE.DirectionalLight(0xc8dcf0, 0.35);
fill.position.set(-30, 25, -20);
scene.add(fill);

// === 地面 (アスファルト風テクスチャ) ===
function makeAsphaltTexture() {
  const c = document.createElement('canvas');
  c.width = 512; c.height = 512;
  const ctx = c.getContext('2d');
  ctx.fillStyle = '#3a3a3c';
  ctx.fillRect(0, 0, 512, 512);
  // ノイズで質感
  const imgData = ctx.getImageData(0, 0, 512, 512);
  for (let i = 0; i < imgData.data.length; i += 4) {
    const n = (Math.random() - 0.5) * 28;
    imgData.data[i] = Math.max(0, Math.min(255, imgData.data[i] + n));
    imgData.data[i+1] = Math.max(0, Math.min(255, imgData.data[i+1] + n));
    imgData.data[i+2] = Math.max(0, Math.min(255, imgData.data[i+2] + n));
  }
  ctx.putImageData(imgData, 0, 0);
  // 細かいヒビ
  ctx.strokeStyle = 'rgba(0,0,0,0.15)';
  ctx.lineWidth = 0.4;
  for (let i = 0; i < 30; i++) {
    ctx.beginPath();
    ctx.moveTo(Math.random() * 512, Math.random() * 512);
    ctx.lineTo(Math.random() * 512, Math.random() * 512);
    ctx.stroke();
  }
  const tex = new THREE.CanvasTexture(c);
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  tex.repeat.set(8, 8);
  return tex;
}
const asphaltTex = makeAsphaltTexture();

// === グラウンドタイル (土) ===
function makeGrassTexture() {
  const c = document.createElement('canvas');
  c.width = 256; c.height = 256;
  const ctx = c.getContext('2d');
  const grad = ctx.createLinearGradient(0, 0, 0, 256);
  grad.addColorStop(0, '#d6dccd');
  grad.addColorStop(1, '#c2c8b8');
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, 256, 256);
  ctx.fillStyle = 'rgba(80,90,60,0.2)';
  for (let i = 0; i < 200; i++) {
    ctx.fillRect(Math.random() * 256, Math.random() * 256, 1.5, 1.5);
  }
  const tex = new THREE.CanvasTexture(c);
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  tex.repeat.set(10, 10);
  return tex;
}
const groundTex = makeGrassTexture();

const ground = new THREE.Mesh(
  new THREE.PlaneGeometry(220, 220),
  new THREE.MeshStandardMaterial({ map: groundTex, roughness: 0.92 })
);
ground.rotation.x = -Math.PI / 2;
ground.receiveShadow = true;
scene.add(ground);

// === 道路 ===
const roadMat = new THREE.MeshStandardMaterial({ map: asphaltTex, roughness: 0.85, metalness: 0.05 });

const mainRoad = new THREE.Mesh(new THREE.PlaneGeometry(6, 100), roadMat);
mainRoad.rotation.x = -Math.PI / 2;
mainRoad.position.y = 0.01;
mainRoad.receiveShadow = true;
scene.add(mainRoad);

const sideRoad = new THREE.Mesh(new THREE.PlaneGeometry(50, 4), roadMat);
sideRoad.rotation.x = -Math.PI / 2;
sideRoad.position.set(-25, 0.01, 0);
sideRoad.receiveShadow = true;
scene.add(sideRoad);

// === 中央線 (黄色破線) ===
function addCenterLine(z1, z2) {
  const len = Math.abs(z2 - z1);
  const dashCount = Math.floor(len / 1.8);
  for (let i = 0; i < dashCount; i++) {
    const dash = new THREE.Mesh(
      new THREE.PlaneGeometry(0.15, 1.0),
      new THREE.MeshStandardMaterial({ color: 0xf9ab00, emissive: 0xb87800, emissiveIntensity: 0.15 })
    );
    dash.rotation.x = -Math.PI / 2;
    dash.position.set(0, 0.025, z1 + i * 1.8 + 0.5);
    scene.add(dash);
  }
}
addCenterLine(-50, -2.5);
addCenterLine(2.5, 50);

// === 路肩線 ===
const shoulderMat = new THREE.MeshStandardMaterial({ color: 0xf8f8f8, roughness: 0.6 });
[
  { p: [3, 0.025, 0], s: [0.15, 100] },
  { p: [-3, 0.025, -25], s: [0.15, 50] },
  { p: [-3, 0.025, 25], s: [0.15, 50] },
  { p: [-25, 0.025, -2], s: [50, 0.15] },
  { p: [-25, 0.025, 2], s: [50, 0.15] },
].forEach(c => {
  const m = new THREE.Mesh(new THREE.PlaneGeometry(c.s[0], c.s[1]), shoulderMat);
  m.rotation.x = -Math.PI / 2;
  m.position.set(c.p[0], c.p[1], c.p[2]);
  scene.add(m);
});

const stopLine = new THREE.Mesh(new THREE.PlaneGeometry(0.4, 4), shoulderMat);
stopLine.rotation.x = -Math.PI / 2;
stopLine.position.set(-3.5, 0.035, 0);
scene.add(stopLine);

// === 一時停止標識 (実物風) ===
function makeStopSign(x, z) {
  const group = new THREE.Group();
  const pole = new THREE.Mesh(
    new THREE.CylinderGeometry(0.04, 0.04, 2.4),
    new THREE.MeshStandardMaterial({ color: 0x999, roughness: 0.7, metalness: 0.6 })
  );
  pole.position.y = 1.2;
  pole.castShadow = true;
  group.add(pole);
  // 標識本体 (逆三角)
  const signGeo = new THREE.CircleGeometry(0.42, 3);
  const signMat = new THREE.MeshStandardMaterial({ color: 0xd93025, side: THREE.DoubleSide, roughness: 0.5, emissive: 0x501010, emissiveIntensity: 0.1 });
  const sign = new THREE.Mesh(signGeo, signMat);
  sign.position.y = 2.45;
  sign.rotation.z = Math.PI;
  sign.castShadow = true;
  group.add(sign);
  // 「止まれ」白文字 (CanvasTexture)
  const tc = document.createElement('canvas');
  tc.width = 128; tc.height = 128;
  const tctx = tc.getContext('2d');
  tctx.fillStyle = '#d93025';
  tctx.fillRect(0, 0, 128, 128);
  tctx.fillStyle = '#fff';
  tctx.font = 'bold 36px sans-serif';
  tctx.textAlign = 'center';
  tctx.fillText('止', 64, 60);
  tctx.fillText('まれ', 64, 98);
  const ttex = new THREE.CanvasTexture(tc);
  const textPlane = new THREE.Mesh(
    new THREE.PlaneGeometry(0.5, 0.5),
    new THREE.MeshStandardMaterial({ map: ttex, transparent: true })
  );
  textPlane.position.set(0, 2.4, 0.02);
  group.add(textPlane);
  group.position.set(x, 0, z);
  scene.add(group);
}
makeStopSign(-4, 3);

// === 信号機 (実物風、グロー付き) ===
function makeTrafficLight(x, z) {
  const group = new THREE.Group();
  const pole = new THREE.Mesh(
    new THREE.CylinderGeometry(0.09, 0.09, 5.8),
    new THREE.MeshStandardMaterial({ color: 0x555, roughness: 0.7, metalness: 0.6 })
  );
  pole.position.y = 2.9;
  pole.castShadow = true;
  group.add(pole);
  const arm = new THREE.Mesh(
    new THREE.CylinderGeometry(0.05, 0.05, 2.5),
    new THREE.MeshStandardMaterial({ color: 0x555, roughness: 0.7, metalness: 0.6 })
  );
  arm.position.set(-1.2, 5.6, 0);
  arm.rotation.z = Math.PI / 2;
  arm.castShadow = true;
  group.add(arm);
  const box = new THREE.Mesh(
    new THREE.BoxGeometry(1.3, 0.45, 0.32),
    new THREE.MeshStandardMaterial({ color: 0x222, roughness: 0.6, metalness: 0.3 })
  );
  box.position.set(-2.3, 5.6, 0);
  box.castShadow = true;
  group.add(box);
  const red = new THREE.Mesh(
    new THREE.SphereGeometry(0.14),
    new THREE.MeshStandardMaterial({ color: 0xff2020, emissive: 0xff2020, emissiveIntensity: 2.5 })
  );
  red.position.set(-1.85, 5.6, 0.19);
  group.add(red);
  // 赤信号の光源
  const redLight = new THREE.PointLight(0xff3030, 1.2, 4);
  redLight.position.set(-1.85, 5.6, 0.5);
  group.add(redLight);
  group.position.set(x, 0, z);
  scene.add(group);
}
// 信号機: 分析班仕様 (3, -12) 北行き車両用、②の北 12m
makeTrafficLight(3, -12);

// === 建物 (改良版:屋根+窓ディテール) ===
function makeBuilding(x, z, w, d, h, wallColor = 0xd0d3c8, roofColor = 0x7a4a35) {
  const group = new THREE.Group();
  // 壁 (テクスチャ風: 簡易ノイズで質感)
  const wallCanvas = document.createElement('canvas');
  wallCanvas.width = 64; wallCanvas.height = 64;
  const wctx = wallCanvas.getContext('2d');
  wctx.fillStyle = `rgb(${(wallColor>>16)&0xff},${(wallColor>>8)&0xff},${wallColor&0xff})`;
  wctx.fillRect(0, 0, 64, 64);
  wctx.fillStyle = 'rgba(0,0,0,0.07)';
  for (let i = 0; i < 30; i++) {
    wctx.fillRect(Math.random() * 64, Math.random() * 64, 2, 2);
  }
  const wallTex = new THREE.CanvasTexture(wallCanvas);
  wallTex.wrapS = wallTex.wrapT = THREE.RepeatWrapping;
  wallTex.repeat.set(2, 2);
  const body = new THREE.Mesh(
    new THREE.BoxGeometry(w, h, d),
    new THREE.MeshStandardMaterial({ map: wallTex, roughness: 0.88, metalness: 0.02 })
  );
  body.position.y = h / 2;
  body.castShadow = true;
  body.receiveShadow = true;
  group.add(body);
  // 屋根 (切妻風: 三角プリズム)
  const roofH = 1.2;
  const roofShape = new THREE.Shape();
  roofShape.moveTo(-d/2 - 0.15, 0);
  roofShape.lineTo(d/2 + 0.15, 0);
  roofShape.lineTo(0, roofH);
  roofShape.closePath();
  const roofGeo = new THREE.ExtrudeGeometry(roofShape, { depth: w + 0.3, bevelEnabled: false });
  const roof = new THREE.Mesh(
    roofGeo,
    new THREE.MeshStandardMaterial({ color: roofColor, roughness: 0.9 })
  );
  roof.rotation.y = Math.PI / 2;
  roof.position.set(w/2 + 0.15, h, -d/2);
  roof.castShadow = true;
  group.add(roof);
  // 窓 (ガラス感)
  const winMat = new THREE.MeshStandardMaterial({
    color: 0x6b8eb0, roughness: 0.15, metalness: 0.5, envMapIntensity: 1.5
  });
  const winCount = Math.max(1, Math.floor(h / 1.5));
  const winW = w * 0.18, winH = 0.7;
  for (let f = 0; f < winCount; f++) {
    const y = 1.0 + f * 1.5;
    if (y > h - 0.3) break;
    for (let i = 0; i < 3; i++) {
      const xOff = -w * 0.3 + i * w * 0.3;
      const win = new THREE.Mesh(new THREE.PlaneGeometry(winW, winH), winMat);
      win.position.set(xOff, y, d / 2 + 0.01);
      group.add(win);
      const winBack = new THREE.Mesh(new THREE.PlaneGeometry(winW, winH), winMat);
      winBack.position.set(xOff, y, -d / 2 - 0.01);
      winBack.rotation.y = Math.PI;
      group.add(winBack);
    }
  }
  group.position.set(x, 0, z);
  scene.add(group);
  return group;
}

