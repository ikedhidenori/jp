  #collision-banner { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: linear-gradient(135deg, #ff5757, #d93025); color: #fff; padding: 22px 32px; border-radius: 14px; font-size: 20px; font-weight: bold; display: none; z-index: 100; box-shadow: 0 12px 40px rgba(217,48,37,.5); border: 2px solid rgba(255,255,255,.2); }
  #collision-banner.show { display: block; animation: pulse 2.5s ease-out; }
  @keyframes pulse { 0% { transform: translate(-50%,-50%) scale(1.6); opacity: 0; } 30% { transform: translate(-50%,-50%) scale(1); opacity: 1; } 100% { opacity: 1; } }
  .hint { font-size: 10px; color: #ffd54f; margin-top: 8px; }
