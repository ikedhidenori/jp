  const cabin = new THREE.Mesh(
    new THREE.BoxGeometry(width * 0.94, cabinHeight, length * 0.58),
    paintMat
  );
  cabin.position.set(0, bodyHeight + 0.42 + cabinHeight / 2, -length * 0.06);
  cabin.castShadow = true;
  group.add(cabin);

  // ウインドウ (黒っぽい、メタリック)
  const glassMat = new THREE.MeshStandardMaterial({
    color: 0x0a0a14, roughness: 0.05, metalness: 1.0, envMapIntensity: 2.0,
    transparent: true, opacity: 0.75
  });
  // 前面 (フロントガラス)
  const windshield = new THREE.Mesh(
    new THREE.BoxGeometry(width * 0.86, cabinHeight * 0.78, 0.03),
    glassMat
  );
  windshield.position.set(0, bodyHeight + 0.42 + cabinHeight * 0.45, -length * 0.06 + length * 0.29);
  group.add(windshield);
  // 後面
  const rearGlass = new THREE.Mesh(
    new THREE.BoxGeometry(width * 0.86, cabinHeight * 0.7, 0.03),
    glassMat
  );
  rearGlass.position.set(0, bodyHeight + 0.42 + cabinHeight * 0.5, -length * 0.06 - length * 0.29);
  group.add(rearGlass);
  // 側面 (左右)
  [-width * 0.475, width * 0.475].forEach(sx => {
    const sideGlass = new THREE.Mesh(
      new THREE.BoxGeometry(0.03, cabinHeight * 0.7, length * 0.52),
      glassMat
    );
    sideGlass.position.set(sx, bodyHeight + 0.42 + cabinHeight * 0.5, -length * 0.06);
