  let i = 0;
  for (; i < kf.length - 1; i++) {
    if (t < kf[i + 1].t) break;
  }
  const k0 = kf[Math.max(0, i - 1)];
  const k1 = kf[i];
  const k2 = kf[i + 1];
  const k3 = kf[Math.min(kf.length - 1, i + 2)];
  const span = k2.t - k1.t;
  if (span <= 0) return k2;
  const u = (t - k1.t) / span;
  // Catmull-Rom (centripetal)
  function cr(p0, p1, p2, p3, u) {
    const u2 = u * u;
    const u3 = u2 * u;
    return 0.5 * (
      (2 * p1) +
      (-p0 + p2) * u +
      (2 * p0 - 5 * p1 + 4 * p2 - p3) * u2 +
      (-p0 + 3 * p1 - 3 * p2 + p3) * u3
    );
  }
  return {
    x: cr(k0.x, k1.x, k2.x, k3.x, u),
    z: cr(k0.z, k1.z, k2.z, k3.z, u),
    heading: cr(k0.heading, k1.heading, k2.heading, k3.heading, u)
  };
}

function setJohnny(t) {
  const p = interpKeyframes(A_keyframes, t);
  johnny.position.set(p.x, 0, p.z);
  johnny.rotation.y = p.heading;
}

function setShibata(t) {
  const p = interpKeyframes(B_keyframes, t);
  shibata.position.set(p.x, 0, p.z);
  shibata.rotation.y = p.heading;
}

// === 視点 ===
let cameraMode = 'overhead';
const camPresets = {
  overhead: { pos: [0, 50, 30], target: [0, 0, 0] },
  guide:    { pos: [1.5, 1.7, -2], target: [-1.5, 0.5, 2] },
  cinema:   { pos: [22, 22, -22], target: [0, 1, 0] },
};

function applyPreset(name) {
  const p = camPresets[name];
  if (!p) return;
  camera.position.set(...p.pos);
  controls.target.set(...p.target);
  controls.update();
}

function setCameraMode(mode) {
  cameraMode = mode;
  document.querySelectorAll('#controls button[id^="cam-"]').forEach(b => b.classList.remove('active'));
  const btn = document.getElementById(`cam-${mode === 'fp-johnny' ? 'johnny-fp' : mode === 'fp-shibata' ? 'shibata-fp' : mode}`);
  if (btn) btn.classList.add('active');
  if (camPresets[mode]) {
    applyPreset(mode);
    controls.enabled = true;
  } else {
    controls.enabled = playing ? false : true;
  }
}

let cameraJustEnabled = false;
function updateFPCamera(mode) {
  let target;
  if (mode === 'fp-johnny') target = johnny;
  else if (mode === 'fp-shibata') target = shibata;
  else return;

  const isJohnny = mode === 'fp-johnny';
  const seatX = isJohnny ? 0.45 : 0.5;
  const seatY = isJohnny ? 1.35 : 1.40;
  const seatZ = isJohnny ? 0.6 : 0.7;

  target.updateMatrixWorld(true);
  const seat = new THREE.Vector3(seatX, seatY, seatZ);
  seat.applyMatrix4(target.matrixWorld);
  const lookAt = new THREE.Vector3(0, 1.0, 10);
  lookAt.applyMatrix4(target.matrixWorld);

  if (playing) {
    camera.position.lerp(seat, 0.85);
    controls.target.lerp(lookAt, 0.85);
    controls.enabled = false;
  } else {
    if (!cameraJustEnabled) {
      camera.position.copy(seat);
      const otherCar = isJohnny ? shibata : johnny;
      controls.target.copy(otherCar.position).add(new THREE.Vector3(0, 1, 0));
      controls.enabled = true;
      cameraJustEnabled = true;
    }
  }
}

document.getElementById('cam-overhead').onclick = () => { cameraJustEnabled = false; setCameraMode('overhead'); };
document.getElementById('cam-johnny-fp').onclick = () => { cameraJustEnabled = false; setCameraMode('fp-johnny'); };
document.getElementById('cam-shibata-fp').onclick = () => { cameraJustEnabled = false; setCameraMode('fp-shibata'); };
document.getElementById('cam-guide').onclick = () => { cameraJustEnabled = false; setCameraMode('guide'); };
document.getElementById('cam-cinema').onclick = () => { cameraJustEnabled = false; setCameraMode('cinema'); };

let t = 0;
let playing = false;
let lastTs = 0;
let collisionTriggered = false;

const playBtn = document.getElementById('play');
const collisionBanner = document.getElementById('collision-banner');

playBtn.onclick = () => {
  playing = !playing;
  playBtn.textContent = playing ? '⏸ 停止' : '▶ 再生';
  lastTs = performance.now();
  if (playing) {
    collisionBanner.classList.remove('show');
    collisionTriggered = false;
    cameraJustEnabled = false;
    if (cameraMode === 'fp-johnny' || cameraMode === 'fp-shibata') controls.enabled = false;
  } else {
    if (cameraMode === 'fp-johnny' || cameraMode === 'fp-shibata') controls.enabled = true;
  }
};

document.getElementById('reset').onclick = () => {
  t = 0; playing = false; collisionTriggered = false; cameraJustEnabled = false;
  playBtn.textContent = '▶ 再生';
  collisionBanner.classList.remove('show');
  setJohnny(t); setShibata(t);
  document.getElementById('time').textContent = `t=${t.toFixed(1)}s`;
};

function loop(ts) {
  if (playing) {
    const dt = (ts - lastTs) / 1000;
    lastTs = ts;
    t += dt;
    if (!collisionTriggered && t >= COLLISION_TIME) {
      t = COLLISION_TIME;
      playing = false;
      collisionTriggered = true;
      playBtn.textContent = '▶ 再生';
      collisionBanner.classList.add('show');
      if (cameraMode === 'fp-johnny' || cameraMode === 'fp-shibata') {
        cameraJustEnabled = false;
      }
      setTimeout(() => collisionBanner.classList.remove('show'), 4500);
    }
    if (t > 5.5) { t = 0; collisionTriggered = false; }
    setJohnny(t); setShibata(t);
    document.getElementById('time').textContent = `t=${t.toFixed(1)}s`;
  }
  if (cameraMode === 'fp-johnny' || cameraMode === 'fp-shibata') updateFPCamera(cameraMode);
  controls.update();
  composer.render();
  requestAnimationFrame(loop);
}

setJohnny(0);
setShibata(0);
setCameraMode('overhead');
requestAnimationFrame(loop);

// ローディング解除
setTimeout(() => {
  document.getElementById('loading').classList.add('hidden');
}, 600);

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
  composer.setSize(window.innerWidth, window.innerHeight);
  bloomPass.resolution.set(window.innerWidth, window.innerHeight);
});
</script>
