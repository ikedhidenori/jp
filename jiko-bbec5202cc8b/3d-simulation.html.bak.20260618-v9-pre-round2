  // テールライト (後方、赤く光る)
  const taillightMat = new THREE.MeshStandardMaterial({
    color: 0xff2020, emissive: 0xff2020, emissiveIntensity: 0.6, roughness: 0.3
  });
  [[-width * 0.32, -length / 2], [width * 0.32, -length / 2]].forEach(([tx, tz]) => {
    const tl = new THREE.Mesh(new THREE.BoxGeometry(0.32, 0.16, 0.06), taillightMat);
    tl.position.set(tx, bodyHeight * 0.6 + 0.42, tz);
    group.add(tl);
  });

  // フロントグリル (黒い細かい縦線)
  if (hasGrille !== false) {
    const grilleGroup = new THREE.Group();
    for (let i = 0; i < 7; i++) {
      const bar = new THREE.Mesh(
        new THREE.BoxGeometry(0.06, 0.3, 0.03),
        new THREE.MeshStandardMaterial({ color: 0x1a1a1a, roughness: 0.4, metalness: 0.5 })
      );
      bar.position.x = -width * 0.22 + i * (width * 0.44 / 6);
      grilleGroup.add(bar);
    }
    grilleGroup.position.set(0, bodyHeight * 0.35 + 0.42, length / 2 + 0.01);
    group.add(grilleGroup);
  }

  // サイドミラー
  const mirrorMat = new THREE.MeshStandardMaterial({
    color: accentColor || color, roughness: 0.3, metalness: 0.5
  });
  [[-width / 2 - 0.04, 0.05], [width / 2 + 0.04, 0.05]].forEach(([mx, mz]) => {
    const mirror = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.12, 0.16), mirrorMat);
    mirror.position.set(mx, bodyHeight + 0.42 + cabinHeight * 0.3, mz + length * 0.14);
    mirror.castShadow = true;
    group.add(mirror);
  });

  // ホイール (タイヤ + リム)
  const tireMat = new THREE.MeshStandardMaterial({ color: 0x0a0a0a, roughness: 0.85, metalness: 0.05 });
  const rimMat = new THREE.MeshStandardMaterial({ color: 0xc8c8c8, roughness: 0.3, metalness: 0.9 });
  const wb = length * 0.32;
  const tw = width * 0.46;
  [[tw, -wb], [-tw, -wb], [tw, wb], [-tw, wb]].forEach(([wx, wz]) => {
    const tire = new THREE.Mesh(
      new THREE.CylinderGeometry(0.38, 0.38, 0.26),
      tireMat
    );
    tire.position.set(wx, 0.38, wz);
    tire.rotation.z = Math.PI / 2;
    tire.castShadow = true;
    group.add(tire);
    // リム (内側、銀色)
    const rim = new THREE.Mesh(
      new THREE.CylinderGeometry(0.24, 0.24, 0.27),
      rimMat
    );
    rim.position.set(wx, 0.38, wz);
    rim.rotation.z = Math.PI / 2;
    group.add(rim);
  });

  // ナンバープレート
  if (plateText) {
    const pc = document.createElement('canvas');
    pc.width = 256; pc.height = 96;
    const pctx = pc.getContext('2d');
    pctx.fillStyle = '#ffffff';
    pctx.fillRect(0, 0, 256, 96);
    pctx.strokeStyle = '#222'; pctx.lineWidth = 4;
    pctx.strokeRect(2, 2, 252, 92);
    pctx.fillStyle = '#222'; pctx.font = 'bold 36px sans-serif'; pctx.textAlign = 'center';
    pctx.fillText(plateText, 128, 62);
    const ptex = new THREE.CanvasTexture(pc);
    const plate = new THREE.Mesh(
      new THREE.PlaneGeometry(0.55, 0.2),
      new THREE.MeshStandardMaterial({ map: ptex })
    );
    plate.position.set(0, 0.55, -length / 2 - 0.01);
    plate.rotation.y = Math.PI;
    group.add(plate);
  }

  // ラベル (sprite)
  const lc = document.createElement('canvas');
  lc.width = 256; lc.height = 64;
  const lctx = lc.getContext('2d');
  lctx.fillStyle = 'rgba(0,0,0,0.75)';
  lctx.fillRect(0, 0, 256, 64);
  lctx.strokeStyle = 'rgba(255,255,255,0.2)';
  lctx.lineWidth = 2;
  lctx.strokeRect(1, 1, 254, 62);
  lctx.fillStyle = '#fff';
  lctx.font = 'bold 32px sans-serif';
  lctx.textAlign = 'center';
  lctx.fillText(label, 128, 44);
  const ltex = new THREE.CanvasTexture(lc);
  const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: ltex, depthTest: false }));
  sprite.scale.set(3, 0.75, 1);
  sprite.position.y = height + 1.2;
  sprite.renderOrder = 999;
  group.add(sprite);

  return group;
}

